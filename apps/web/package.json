{
  "name": "@orbitwatch/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm run cesium:copy",
    "dev": "next dev",
    "prebuild": "pnpm run cesium:copy",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rimraf .next .turbo public/cesium",
