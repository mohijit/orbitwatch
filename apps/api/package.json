{
  "name": "@orbitwatch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@orbitwatch/cache": "workspace:*",
    "@orbitwatch/contracts": "workspace:*",
    "@orbitwatch/database": "workspace:*",
    "@orbitwatch/orbit-core": "workspace:*",
    "@orbitwatch/providers": "workspace:*",
    "fastify": "^5.6.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@orbitwatch/eslint-config": "workspace:*",
    "@orbitwatch/typescript-config": "workspace:*",
    "@orbitwatch/worker": "workspace:*",
    "@types/node": "^24.3.0",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
