# OrbitWatch environment configuration
#
# Copy this file to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored and MUST NOT be committed. Nothing in this file is a
# real credential; it is a template of NAMES only.
#
# ─────────────────────────────────────────────────────────────────────────────
# THE ONE RULE
#
#   Variables prefixed NEXT_PUBLIC_ or EXPO_PUBLIC_ are embedded in the client
#   bundle and are readable by anyone who opens the app. Everything else is
#   server-only.
#
#   Never add a secret to a NEXT_PUBLIC_ or EXPO_PUBLIC_ variable. There is no
#   such thing as a public secret.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# DATABASE — Supabase Postgres                     [SERVER ONLY] [REQUIRED for M2]
# ═════════════════════════════════════════════════════════════════════════════
#
# Where to find these:
#   Supabase dashboard → your project → Project Settings → Database →
#   Connection string → URI
#
# Supabase offers several connection strings. Which one matters:
#
#   DATABASE_URL         Use the POOLED (Transaction mode, port 6543) string.
#                        The API opens many short-lived connections and the
#                        pooler is what keeps that within the free-tier limit.
#
#   DATABASE_DIRECT_URL  Use the DIRECT (Session mode, port 5432) string.
#                        Migrations issue DDL, which the transaction pooler does
#                        not support. If you omit this, migrations fall back to
#                        DATABASE_URL and will fail against a pooled connection.
#
# Both contain your database password inline. Treat the whole string as a secret.
#
DATABASE_URL=
DATABASE_DIRECT_URL=

# Optional tuning. Defaults shown; omit unless you need to change them.
# Kept low because the Supabase free tier caps concurrent connections.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Leave "true" for any hosted database. Only set "false" for a local container
# without TLS — the failure mode of getting this wrong is plaintext credentials
# crossing the network.
DATABASE_SSL=true


# ═════════════════════════════════════════════════════════════════════════════
# CACHE — Upstash Redis                            [SERVER ONLY] [OPTIONAL]
# ═════════════════════════════════════════════════════════════════════════════
#
# Where to find these:
#   Upstash console → your Redis database → REST API →
#   UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
#
# Optional by design. With both unset the app runs with the in-process L1 cache
# only, which is correct and supported — it degrades throughput, not availability,
# and /health reports the shared layer as absent rather than pretending.
#
# Set BOTH or NEITHER. Half-configured is rejected at startup, because it means
# a shared cache was intended and would not be delivered.
#
# The token grants full read/write to that Redis. It is server-only and is
# scrubbed from error messages before they can reach a log.
#
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Namespace lets several environments share one Redis safely.
CACHE_NAMESPACE=ow
CACHE_L1_TTL_MS=5000


# ═════════════════════════════════════════════════════════════════════════════
# PROVIDERS                                        [SERVER ONLY] [ALL OPTIONAL]
# ═════════════════════════════════════════════════════════════════════════════
#
# CelesTrak, NOAA SWPC, SatNOGS and WhereTheISS.at need no credentials.
# Launch Library 2 works unauthenticated at 15 requests/hour.

# Launch Library 2 API key. Raises the rate limit above the unauthenticated 15/hour.
# Register at thespacedevs.com. Not required.
LAUNCH_LIBRARY_API_KEY=

# NASA API key for DONKI space-weather events. Without it the code uses
# DEMO_KEY, which is throttled to roughly 30 requests/hour per IP.
# Free key from api.nasa.gov.
NASA_API_KEY=

# N2YO key. OPTIONAL and used only to cross-check our own SGP4 output.
# It must never drive the animation — positions are always computed locally.
N2YO_API_KEY=

# Space-Track credentials. DISABLED BY DEFAULT and deliberately so: their terms
# restrict redistribution of derived data. Normal public deployment must work
# without these, and enabling them is an explicit administrator decision.
# Leave blank unless you have read the terms and accepted the obligations.
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=


# ═════════════════════════════════════════════════════════════════════════════
# WEB APP                                                   [apps/web/.env.local]
# ═════════════════════════════════════════════════════════════════════════════
#
# Cesium Ion token. OPTIONAL — the globe uses the offline Natural Earth imagery
# bundled with Cesium and runs with zero credentials. A token unlocks world
# terrain and high-resolution imagery.
#
# This one IS public by design: Ion tokens are meant to be used from the browser.
# Restrict it to your domain in the Ion dashboard.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Base URL of the API service, as the browser should reach it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333


# ═════════════════════════════════════════════════════════════════════════════
# MOBILE APP                                             [apps/mobile/.env.local]
# ═════════════════════════════════════════════════════════════════════════════
#
# EXPO_PUBLIC_ variables are embedded in the shipped app binary. Anyone can
# extract them. Never put a secret here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3333

# Expo project id, from your Expo dashboard. Needed for EAS builds and push.
EXPO_PROJECT_ID=


# ═════════════════════════════════════════════════════════════════════════════
# API AND WORKER                                                   [SERVER ONLY]
# ═════════════════════════════════════════════════════════════════════════════
PORT=3333
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
