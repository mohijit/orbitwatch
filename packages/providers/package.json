{
  "name": "@orbitwatch/providers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@orbitwatch/typescript-config": "workspace:*",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@orbitwatch/eslint-config": "workspace:*",
    "eslint": "^9.36.0"
  }
}
